{
  "name": "@sockulags/agent-os",
  "version": "0.11.0",
  "description": "A lightweight personal agent operating system with an npx installer for Claude Code and Codex.",
  "type": "module",
  "bin": {
    "agent-os": "./cli/index.mjs"
  },
  "files": [
    "cli/",
    "hooks/",
    "policy.md",
    "skills/"
  ],
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "test": "node --test cli/index.test.mjs skills/quality-ratchet/scripts/quality-delta.test.mjs",
    "test:evals": "node scripts/test-eval-agent-behavior.mjs",
    "validate": "node scripts/validate-agent-os.mjs",
    "verify:release": "node scripts/verify-release.mjs"
  },
  "keywords": [
    "agent",
    "claude-code",
    "codex",
    "workflow",
    "skills",
    "installer"
  ],
  "homepage": "https://sockulags.github.io/agent-os/",
  "repository": "https://github.com/sockulags/agent-os"
}
