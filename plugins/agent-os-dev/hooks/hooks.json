{
  "description": "Agent OS dev hooks: the quality-ratchet delivery Stop gate and the guard hooks that read .agent-os/guards.json.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/skills/quality-ratchet/scripts/guards.mjs\" hook --agent-os-hook=guards",
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -EncodedCommand ",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|apply_patch|shell|exec_command|local_shell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/skills/quality-ratchet/scripts/guards.mjs\" hook --agent-os-hook=guards",
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -EncodedCommand ",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/skills/quality-ratchet/scripts/quality-delta.mjs\" hook --agent-os-hook=quality-ratchet",
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -EncodedCommand ",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
